{
  "name": "nutrition-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval:photo": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --conditions=react-server --env-file=.env.local --import tsx eval/photo-eval.ts",
    "eval:agent": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --conditions=react-server --env-file=.env.local --import tsx eval/agent-eval.ts",
    "user:create": "TSX_TSCONFIG_PATH=tsconfig.scripts.json node --env-file=.env.local --import tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.154",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@ai-sdk/react": "^4.0.186",
    "@date-fns/tz": "^1.5.0",
    "@supabase/supabase-js": "^2.119.2",
    "ai": "^7.0.181",
    "barcode-detector": "^3.2.4",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module"
}
