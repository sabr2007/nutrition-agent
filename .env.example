# Copy to .env.local for local development. Production values live in Vercel env vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Web push (generate: pnpm exec web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for pg_cron -> /api/cron/tick
CRON_SECRET=
# 32-byte base64 key for encrypting provider OAuth tokens
APP_ENCRYPTION_KEY=
APP_URL=http://localhost:3000

# LLM providers (all optional; see docs/SETUP.md)
# On Vercel, AI Gateway authenticates via OIDC automatically. Locally use a key:
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Sign in with ChatGPT (after app registration with OpenAI)
CHATGPT_OAUTH_CLIENT_ID=
CHATGPT_OAUTH_CLIENT_SECRET=
