# Copy to .env.local for local development. Production values live in Vercel env vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Web push (generate: pnpm exec web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for pg_cron -> /api/cron/tick
CRON_SECRET=
# 32-byte base64 key for encrypting provider OAuth tokens
APP_ENCRYPTION_KEY=
APP_URL=http://localhost:3000

# Models run on the owner's ChatGPT plan (tokens arrive via scripts/chatgpt-login.ts, see docs/SETUP.md).
# Voice notes only: Whisper on Cloudflare Workers AI (the ChatGPT plan has no transcription).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Telegram bot (v2). Webhook secret: 1–256 chars of A-Za-z0-9_-; pairing code: send /start <code> to the bot once.
# Register the webhook, commands and menu button: node --env-file=.env.local --import tsx scripts/telegram-setup.ts
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PAIRING_CODE=

# Google Health API (wearable data) — OAuth web client, redirect URI <APP_URL>/api/health/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional model overrides (D26). Defaults: agent and web lookup on gpt-6.1-sol; the built-in
# web_search tool is given only to models where it was verified on the ChatGPT plan.
# AGENT_MODEL=gpt-6.1-sol
# WEB_SEARCH_MODEL=gpt-6.1-sol
# WEB_SEARCH_MODELS=gpt-6.1-sol,gpt-6.2-sol
